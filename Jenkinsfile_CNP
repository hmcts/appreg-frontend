#!groovy

properties([
  copyArtifactPermission('*'),
  parameters([
    choice(
      name: 'RegressionSuite',
      choices: ['Core', 'Full'],
      description: 'Select one regression suite to run'
    )
  ])
])

@Library('Infrastructure@2.4.4')

def type = 'angular'
def product = 'appreg'
def component = 'frontend'

def branchesToSync = ['demo']

def vaultOverrides = [
  'dev': 'stg',
  'preview': 'stg',
]

def secrets = [
  'appreg-${env}': [
    secret('POSTGRES-USER', 'DB_USER'),
    secret('POSTGRES-PASS', 'DB_PASSWORD'),
    secret('POSTGRES-HOST', 'DB_HOST'),
    secret('POSTGRES-PORT', 'DB_PORT'),
    secret('POSTGRES-DATABASE', 'DB_NAME'),
    secret('TEST-USER1-EMAIL', 'TEST_USER1_EMAIL'),
    secret('TEST-USER2-EMAIL', 'TEST_USER2_EMAIL'),
    secret('TEST-USER3-EMAIL', 'TEST_USER3_EMAIL'),
    secret('TEST-ADMIN1-EMAIL', 'TEST_ADMIN1_EMAIL'),
    secret('TEST-ADMIN2-EMAIL', 'TEST_ADMIN2_EMAIL'),
    secret('TEST-ADMIN3-EMAIL', 'TEST_ADMIN3_EMAIL'),
    secret('TEST-USERS-PASSWORD', 'TEST_USERS_PASSWORD'),
  ],
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [
    $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar,
  ]
}

def publishFunctionalReports = {
  archiveArtifacts allowEmptyArchive: true, artifacts: 'functional-output/**/*'

  junit allowEmptyResults: true, testResults: 'functional-output/**/*.xml'

  publishHTML([
    allowMissing: true,
    alwaysLinkToLastBuild: true,
    keepAll: true,
    reportDir: 'functional-output/chrome/smoke/cucumber-html',
    reportFiles: 'detailed-test-report.html',
    reportName: 'Cucumber Detailed Report',
    reportTitles: 'Cucumber Detailed Report',
  ])
}

// If run_full_regression label is present in PR we will run the full suite
def hasFullRegressionLabel() {
  def githubApi = new GithubAPI(this)

  return githubApi
    .getLabelsbyPattern(env.BRANCH_NAME, 'run_full_regression')
    .any { label -> label == 'run_full_regression' }
}

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)

withPipeline(type, product, component) {
  overrideVaultEnvironments(vaultOverrides)
  loadVaultSecrets(secrets)
  enableSlackNotifications('#appreg-builds')

  // default to core if param is undefined
  // Try to find label else fallback to the build params
  def regressionSuite = hasFullRegressionLabel()
    ? 'Full'
    : (params.RegressionSuite ?: 'Core')

  echo 'Regression suite type that will be run: ' + regressionSuite

  afterAlways('functionalTest:dev') {
    script { publishFunctionalReports() }

    yarnBuilder.yarn('cypress:clean:reports')

    // opt-in tag for a full regression test
    if (regressionSuite == 'Full') {
        stage('Full regression test') {
          catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', message: 'Full regression tests failed') {
            try {
              yarnBuilder.yarn('test:parallel:regression:chrome')
            } finally {
              archiveArtifacts allowEmptyArchive: true, artifacts: 'functional-output/chrome/regression/**/*'
              junit allowEmptyResults: true, testResults: 'functional-output/**/*.xml,cypress/reports/junit/**/*.xml'

              publishHTML target: [
                allowMissing         : true,
                alwaysLinkToLastBuild: true,
                keepAll              : true,
                reportDir            : 'functional-output/chrome/regression/cucumber-html',
                reportFiles          : 'full-regression-test-report.html',
                reportName           : 'Cucumber Full Regression Test Report'
              ]
            }
          }
        }
      }

    if (regressionSuite == 'Core') {
        stage('Core regression test') {
          catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', message: 'Core regression tests failed') {
            try {
              yarnBuilder.yarn('test:parallel:regression:core:chrome')
            } finally {
              archiveArtifacts allowEmptyArchive: true, artifacts: 'functional-output/chrome/regression/**/*'
              junit allowEmptyResults: true, testResults: 'functional-output/**/*.xml,cypress/reports/junit/**/*.xml'
              publishHTML target: [
                allowMissing         : true,
                alwaysLinkToLastBuild: true,
                keepAll              : true,
                reportDir            : 'functional-output/chrome/regression/cucumber-html',
                reportFiles          : 'core-regression-test-report.html',
                reportName           : 'Cucumber Core Regression Test Report'
              ]
            }
          }
        }
      }
    }

  afterAlways('functionalTest:stg') {
    script { publishFunctionalReports() }
  }




  syncBranchesWithMaster(branchesToSync)
}
